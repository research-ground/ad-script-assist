{
  "name": "ad-script-assist-server",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.0",
  "dependencies": {
    "@google/genai": "^2.8.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "kokoro-js": "^1.2.1",
    "lit": "^3.3.3",
    "mediabunny": "1.57.0",
    "openai": "^6.44.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "vite",
    "build": "vite build && vite build --ssr src/server.ts --outDir dist/server --emptyOutDir false",
    "preview": "vite preview",
    "test:setup": "tsx tests/setup_tests.ts",
    "pretest:cli": "tsx tests/setup_tests.ts",
    "test:cli": "tsx --test --test-concurrency=1 tests/cli/**/*.test.ts",
    "pretest:ui": "tsx tests/setup_tests.ts",
    "test:ui": "tsx --test --test-concurrency=1 tests/ui/**/*.test.ts",
    "pretest:e2e": "tsx tests/setup_tests.ts",
    "test:e2e": "tsx --test --test-concurrency=1 tests/e2e/**/*.test.ts"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^25.9.3",
    "puppeteer": "^25.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
